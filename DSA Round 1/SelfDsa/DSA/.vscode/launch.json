{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kill old exe",
            "type": "shell",
            // Suppress error if exe is not running
            "command": "taskkill /IM ${fileBasenameNoExtension}.exe /F || exit 0",
            "problemMatcher": [],
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Build C++ file",
            "type": "shell",
            "dependsOn": "Kill old exe",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
